# Anyone can start the bot; before using it they must be a member of this
# channel (checked live via Telegram's getChatMember on every update).
# The bot account itself must be a member/admin of the channel for this
# check to work. Leave REQUIRED_CHANNEL_USERNAME empty to disable the gate.
REQUIRED_CHANNEL_USERNAME=@drpuaro_net
REQUIRED_CHANNEL_LINK=https://t.me/drpuaro_net

